# 本地演示配置。不要写入真实密钥、内网地址或生产库连接。
PORT=4317
HOST=127.0.0.1

# deterministic：Pi SDK 的 faux 模型，不访问外部模型，也不需要密钥。
# pi：AgentSession。faux 是显式本地伪模型。openai-compatible 默认只接受 http://127.0.0.1 的自建服务。
# 缺少 PI_BASE_URL、PI_MODEL、PI_API_KEY、PI_CONTEXT_WINDOW 或 PI_MAX_OUTPUT_TOKENS 会直接失败，不会改用 faux。
# 不预置公司模型名称；DeepSeek 官方服务只能显式启用并用于隔离合成演示。
MODEL_MODE=deterministic
PI_PROVIDER=anthropic
PI_MODEL=
PI_API_KEY=
PI_BASE_URL=
PI_CONTEXT_WINDOW=
PI_MAX_OUTPUT_TOKENS=
PI_REASONING=off
PI_ENABLED_REASONING=off
PI_ALLOW_REMOTE_HTTPS=false

# 知识、只读合成业务库，以及独立的本地状态库。文件应落在 .local-runtime/，不要提交。
KNOWLEDGE_DIR=
DATABASE_PATH=
STATE_DATABASE_PATH=
FRESHNESS_PATH=
FRESHNESS_SOURCE_PATH=
PUBLISH_FRESHNESS_ON_START=true
MAX_MODEL_CALLS=16
MAX_TOOL_CALLS=40
# 会话知识正文预算，UTF-8 字节；新会话首次读取时固定上限。
MAX_ASSET_READ_BYTES=200000

# sqlite：单进程演示。mysql：必须同时启动 api、dispatcher、worker，并只连 127.0.0.1 上的隔离实例。
STATE_MODE=sqlite
BUSINESS_ENGINE=sqlite
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
REDIS_HOST=127.0.0.1
REDIS_PORT=
REDIS_PASSWORD=
REDIS_QUEUE_KEY=lumenfox:local:jobs

# 单机租约。MySQL 模式用同一组超时做持久化租约，Redis 不保存租约。
LEASE_MS=15000
HEARTBEAT_MS=2000
POLL_MS=200

QUERY_TIMEOUT_MS=3000
QUERY_LATENCY_MS=0
MAX_RESULT_ROWS=10000
MAX_RESULT_BYTES=2000000
JOB_TIMEOUT_MS=60000
TOOL_DELAY_MS=0

# 默认按契约/知识包时区的当前日期检查；仅合成测试需要固定日期时填写。
SIMULATED_TODAY=
DEFAULT_ROLE=analyst
