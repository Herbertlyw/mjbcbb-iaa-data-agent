      "dataset_version",
      "cohort_date",
      "revenue_date",
      "app_id",
      "acquisition_country_code",
      "ua_channel_id",
      "campaign_id",
      "ad_group_id",
      "ad_id",
      "creative_id",
      "revenue_source",
      "revenue_usd",
      "revenue_callback_count",
      "age_days",
      "observed_at",
      "completeness_state"
    ]
  },
