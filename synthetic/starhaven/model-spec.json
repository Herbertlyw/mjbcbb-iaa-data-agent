    "dataset_version_required": true,
    "aggregation_rules": [],
    "declared_column_names": [
      "dataset_version",
      "business_date",
      "app_id",
      "activity_country_code",
      "ad_format",
      "network_code",
      "event_schema_version",
      "load_attempts",
      "completed_load_attempts",
      "successful_load_attempts",
      "show_actions",
      "ready_actions",
      "completed_show_requests",
      "successful_show_requests",
      "impressions",
      "clicks",
      "revenue_usd",
      "completeness_state"
    ]
  },
  {
    "asset": "fact_cohort_revenue_daily",
    "role": "分来源回收",
    "grain": "cohort_date + revenue_date + app + 获客范围 + revenue_source",
