[
  {
    "metric_id": "raw_cost_usd",
    "label": "原始消耗USD",
    "formula": "SUM(raw_cost_usd)",
    "unit": "USD",
    "inputs": [
      "fact_delivery_daily.raw_cost_usd"
    ],
    "guard": "先逐行换汇再汇总，不把原币跨币种相加。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "discounted_cost_usd",
    "label": "折后消耗USD",
    "formula": "SUM(discounted_cost_usd)",
    "unit": "USD",
    "inputs": [
      "fact_delivery_daily.discounted_cost_usd"
    ],
    "guard": "与原始消耗分开；缺汇率的行不能被SUM静默忽略为完整。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "impressions",
    "label": "投放曝光",
    "formula": "SUM(impressions)",
    "unit": "次",
    "inputs": [
      "fact_delivery_daily.impressions"
    ],
    "guard": "按投放报表日与约定归属统计，不等于游戏内广告展示。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "clicks",
    "label": "投放点击",
    "formula": "SUM(clicks)",
    "unit": "次",
    "inputs": [
      "fact_delivery_daily.clicks"
    ],
    "guard": "与游戏内广告点击分开。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "af_registers",
    "label": "AF报表注册",
    "formula": "SUM(af_registers)",
    "unit": "报表注册",
    "inputs": [
      "fact_delivery_daily.af_registers"
    ],
    "guard": "不是AF ODS去重安装事件，也不是行为D0。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "media_registers",
    "label": "媒体报表注册",
    "formula": "SUM(media_registers)",
    "unit": "报表注册",
    "inputs": [
      "fact_delivery_daily.media_registers"
    ],
    "guard": "按媒体口径保留来源。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "ctr",
    "label": "投放CTR",
    "formula": "SUM(clicks) / SUM(impressions)",
    "unit": "比例",
    "inputs": [
      "fact_delivery_daily.clicks",
      "fact_delivery_daily.impressions"
    ],
    "guard": "分母0为未知；展示时才转百分比，不平均每日比率。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "af_cvr",
    "label": "AF注册/点击比",
    "formula": "SUM(af_registers) / SUM(clicks)",
    "unit": "比例",
    "inputs": [
      "fact_delivery_daily.af_registers",
      "fact_delivery_daily.clicks"
    ],
    "guard": "非纯点击归因时不称点击转化概率，不机械限制<=1。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "af_ipm",
    "label": "AF注册IPM",
    "formula": "SUM(af_registers) / SUM(impressions) * 1000",
    "unit": "报表注册/千次曝光",
    "inputs": [
      "fact_delivery_daily.af_registers",
      "fact_delivery_daily.impressions"
    ],
    "guard": "分子身份固定，跨天先汇总分子分母。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "af_cpi_usd",
    "label": "AF报表CPI",
    "formula": "SUM(discounted_cost_usd) / SUM(af_registers)",
    "unit": "USD/报表注册",
    "inputs": [
      "fact_delivery_daily.discounted_cost_usd",
      "fact_delivery_daily.af_registers"
    ],
    "guard": "不把分母自动替换成unique_install_events。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "cpm_usd",
    "label": "投放CPM",
    "formula": "SUM(discounted_cost_usd) / SUM(impressions) * 1000",
    "unit": "USD/千次曝光",
    "inputs": [
      "fact_delivery_daily.discounted_cost_usd",
      "fact_delivery_daily.impressions"
    ],
    "guard": "0分母为未知，与变现eCPM分开。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "unique_install_events",
    "label": "去重安装事件",
    "formula": "SUM(unique_install_events)",
    "unit": "安装事件",
    "inputs": [
      "fact_acquisition_daily.unique_install_events"
    ],
    "guard": "按合成install_event_id去重；重装仍是事件，不能叫新增设备。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "first_install_devices",
    "label": "首次安装设备",
    "formula": "SUM(first_install_devices)",
    "unit": "设备×App",
    "inputs": [
      "fact_acquisition_daily.first_install_devices"
    ],
    "guard": "首次安装与首次活跃不强制相等；跨App不声称物理设备去重。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "dnu_active_devices",
    "label": "行为D0设备",
    "formula": "SUM(new_active_devices)",
    "unit": "设备×App",
    "inputs": [
      "fact_activity_daily.new_active_devices"
    ],
    "guard": "当日首次活跃口径，不代替媒体注册。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "dau_devices",
    "label": "DAU设备",
    "formula": "SUM(active_devices) for one activity_date",
    "unit": "设备×App",
    "inputs": [
      "fact_activity_daily.active_devices"
    ],
    "guard": "跨天求和只是设备日；国家/UA按固定首次获客分群。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "active_7d_devices",
    "label": "最近7日活跃设备",
    "formula": "SUM(active_devices_7d) at a single anchor day",
    "unit": "去重设备×App",
    "inputs": [
      "fact_activity_daily.active_devices_7d"
    ],
    "guard": "窗口为D-6..D；不是自然周，不可跨锚点日期相加。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "active_30d_devices",
    "label": "最近30日活跃设备",
    "formula": "SUM(active_devices_30d) at a single anchor day",
    "unit": "去重设备×App",
    "inputs": [
      "fact_activity_daily.active_devices_30d"
    ],
    "guard": "窗口为D-29..D；不是自然月，不可跨锚点日期相加。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "daily_to_30d_active",
    "label": "DAU/近30日活跃",
    "formula": "DAU(D) / Active30D(D)",
    "unit": "比例",
    "inputs": [
      "fact_activity_daily.active_devices",
      "fact_activity_daily.active_devices_30d"
    ],
    "guard": "同一App、同一锚点、同一固定分群。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "device_rr_n",
    "label": "设备安装cohort RR_N",
    "formula": "SUM(retained_devices at age=N) / SUM(cohort_size_devices once per cohort)",
    "unit": "比例",
    "inputs": [
      "fact_cohort_quality_daily.retained_devices",
      "fact_cohort_quality_daily.cohort_size_devices",
      "fact_cohort_quality_daily.age_days"
    ],
    "guard": "第N日而非前N日累计；仅支持0≤N≤30；未成熟不补0；不能称AF报表留存。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "games_per_active_device",
    "label": "活跃设备人均局数",
    "formula": "SUM(game_count) / SUM(active_devices)",
    "unit": "局/设备日",
    "inputs": [
      "fact_activity_daily.game_count",
      "fact_activity_daily.active_devices"
    ],
    "guard": "跨日分母为设备日，标签不写去重用户。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "finished_game_mean_seconds",
    "label": "已结束局平均时长",
    "formula": "SUM(gameplay_seconds for finished games) / SUM(games_finished)",
    "unit": "秒/已结束局",
    "inputs": [
      "fact_gameplay_daily.gameplay_seconds",
      "fact_gameplay_daily.games_finished"
    ],
    "guard": "时长仅属于已结束局；不得用包含进行中时长的口径替换。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "mode_win_rate",
    "label": "可判胜负局胜率",
    "formula": "SUM(games_won) / SUM(eligible_win_games)",
    "unit": "比例",
    "inputs": [
      "fact_gameplay_daily.games_won",
      "fact_gameplay_daily.eligible_win_games"
    ],
    "guard": "没有胜负定义的模式为不适用；不把未结束局当失败。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "revive_click_rate",
    "label": "复活提示点击率",
    "formula": "SUM(revive_clicks) / SUM(revive_prompts)",
    "unit": "比例",
    "inputs": [
      "fact_gameplay_daily.revive_clicks",
      "fact_gameplay_daily.revive_prompts"
    ],
    "guard": "点击不是看完激励广告或成功复活。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "arpdau_usd",
    "label": "广告ARPDAU",
    "formula": "SUM(ad_revenue_usd) / SUM(active_devices)",
    "unit": "USD/设备日",
    "inputs": [
      "fact_activity_daily.ad_revenue_usd",
      "fact_activity_daily.active_devices"
    ],
    "guard": "只含广告收入；不把IAP加进同一已定义指标。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "ad_view_penetration",
    "label": "广告观看渗透率",
    "formula": "SUM(ad_viewing_devices) / SUM(active_devices)",
    "unit": "比例",
    "inputs": [
      "fact_activity_daily.ad_viewing_devices",
      "fact_activity_daily.active_devices"
    ],
    "guard": "不是load成功率或fill rate。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "monetization_ecpm_usd",
    "label": "广告变现eCPM",
    "formula": "SUM(revenue_usd) / SUM(impressions) * 1000",
    "unit": "USD/千次展示",
    "inputs": [
      "fact_ad_funnel_daily.revenue_usd",
      "fact_ad_funnel_daily.impressions"
    ],
    "guard": "统一格式、network与事件版本；收入回调缺失导致partial。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "load_success_rate",
    "label": "已结束加载尝试成功率",
    "formula": "SUM(successful_load_attempts) / SUM(completed_load_attempts)",
    "unit": "比例",
    "inputs": [
      "fact_ad_funnel_daily.successful_load_attempts",
      "fact_ad_funnel_daily.completed_load_attempts"
    ],
    "guard": "新合成定义；不沿用公司另一请求分母的fill rate名称。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "load_completion_coverage",
    "label": "加载尝试结束覆盖",
    "formula": "SUM(completed_load_attempts) / SUM(load_attempts)",
    "unit": "比例",
    "inputs": [
      "fact_ad_funnel_daily.completed_load_attempts",
      "fact_ad_funnel_daily.load_attempts"
    ],
    "guard": "与成功率分列，避免未结束尝试被忽略。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "action_ready_rate",
    "label": "调用show时ready比例",
    "formula": "SUM(ready_actions) / SUM(show_actions)",
    "unit": "比例",
    "inputs": [
      "fact_ad_funnel_daily.ready_actions",
      "fact_ad_funnel_daily.show_actions"
    ],
    "guard": "ready不等于show成功；不能与另一事件族混合。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "show_success_rate",
    "label": "已结束展示请求成功率",
    "formula": "SUM(successful_show_requests) / SUM(completed_show_requests)",
    "unit": "比例",
    "inputs": [
      "fact_ad_funnel_daily.successful_show_requests",
      "fact_ad_funnel_daily.completed_show_requests"
    ],
    "guard": "请求与展示/点击事件分别计数；不能要求跨日load数始终大于展示数。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "sdk_ltv_n_per_af_register",
    "label": "实际SDK累计LTV_N（AF注册分母）",
    "formula": "SDK revenue at age 0..N-1 / AF registers for same cohorts",
    "unit": "USD/报表注册",
    "inputs": [
      "fact_cohort_revenue_daily.revenue_usd",
      "fact_cohort_revenue_daily.age_days",
      "fact_cohort_revenue_daily.revenue_source",
      "fact_delivery_daily.af_registers"
    ],
    "guard": "显式指定来源、cohort范围和成熟度；不是设备cohort LTV。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "sdk_device_ltv_n",
    "label": "设备cohort广告LTV_N",
    "formula": "SUM(ad_revenue_usd at age 0..N-1) / cohort_size counted once",
    "unit": "USD/设备×App",
    "inputs": [
      "fact_cohort_quality_daily.ad_revenue_usd",
      "fact_cohort_quality_daily.cohort_size_devices",
      "fact_cohort_quality_daily.age_days"
    ],
    "guard": "仅支持1≤N≤31，累计日龄0..N-1；保留设备身份，不与AF注册LTV直接替换。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "actual_roi_n_pct",
    "label": "实际累计ROI_N",
    "formula": "SUM(revenue_usd for selected source at age 0..N-1) / SUM(discounted_cost_usd for cohorts) * 100",
    "unit": "%",
    "inputs": [
      "fact_cohort_revenue_daily.revenue_usd",
      "fact_cohort_revenue_daily.age_days",
      "fact_cohort_revenue_daily.revenue_source",
      "fact_delivery_daily.discounted_cost_usd"
    ],
    "guard": "ROI7对应0..6；自然量零成本时ROI未知；不得混入预测或多个收入来源。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "predicted_roi_n_pct",
    "label": "快照预测ROI_N",
    "formula": "predicted_revenue_usd / cost_as_of_usd * 100",
    "unit": "%",
    "inputs": [
      "fact_roi_forecast_snapshot.predicted_revenue_usd",
      "fact_roi_forecast_snapshot.cost_as_of_usd"
    ],
    "guard": "固定snapshot、horizon、model_version、revenue_source；零成本未知。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "forecast_error_pp",
    "label": "预测误差百分点",
    "formula": "actual_roi_pct - predicted_roi_pct for same prediction_id",
    "unit": "百分点",
    "inputs": [
      "fact_roi_forecast_evaluation.actual_roi_pct",
      "fact_roi_forecast_evaluation.predicted_roi_pct"
    ],
    "guard": "仅成熟且完整、input_revision_state可比的同一快照目标；成本输入回刷不能直接归为模型错误。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "cost_weighted_forecast_error_pp",
    "label": "成本加权预测误差",
    "formula": "SUM(roi_error_pp * cost_weight_usd) / SUM(cost_weight_usd)",
    "unit": "百分点",
    "inputs": [
      "fact_roi_forecast_evaluation.roi_error_pp",
      "fact_roi_forecast_evaluation.cost_weight_usd"
    ],
    "guard": "同目标窗口和版本；不以简单AVG替代；正负方向与forecast_error_pp一致。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "forecast_target_surplus_usd",
    "label": "预测目标回收差额",
    "formula": "predicted_revenue_usd - cost_as_of_usd * target_roi_pct / 100",
    "unit": "USD",
    "inputs": [
      "fact_roi_forecast_snapshot.predicted_revenue_usd",
      "fact_roi_forecast_snapshot.cost_as_of_usd",
      "config_business_policy_snapshot.target_roi_pct"
    ],
    "guard": "是合成经营目标差额，不称税后净利润或可执行投放指令。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "creative_test_rate",
    "label": "适用素材测试率",
    "formula": "COUNT DISTINCT tested creative_id / COUNT DISTINCT eligible uploaded creative_id",
    "unit": "比例",
    "inputs": [
      "fact_creative_test_snapshot.is_tested",
      "fact_creative_test_snapshot.is_eligible",
      "dim_creative.creative_id",
      "dim_creative.upload_at"
    ],
    "guard": "明确适用上传窗/媒体计划与成熟度；未分配测试范围单列，不能把同素材多媒体行相加。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "creative_graduation_rate",
    "label": "可观测素材出坡率",
    "formula": "COUNT DISTINCT graduated creative_id / COUNT DISTINCT observable creative_id",
    "unit": "比例",
    "inputs": [
      "fact_creative_test_snapshot.is_graduated",
      "fact_creative_test_snapshot.is_observable",
      "fact_creative_test_snapshot.creative_id"
    ],
    "guard": "同规则版本；证据缺失时状态未知，不写未通过。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "experiment_rr_n",
    "label": "实验入组cohort留存",
    "formula": "active_units at age=N / enrolled_units once per entry cohort",
    "unit": "比例",
    "inputs": [
      "fact_experiment_cohort_daily.active_units",
      "fact_experiment_cohort_daily.enrolled_units",
      "fact_experiment_cohort_daily.age_days"
    ],
    "guard": "仅支持0≤N≤30；anchor_type固定；商业化触发日不改名为安装日；成熟度按实验锚点判断。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "experiment_revenue_per_enrolled",
    "label": "实验单位累计广告收入",
    "formula": "SUM(ad_revenue_usd in observation window) / enrolled_units once",
    "unit": "USD/分配单位",
    "inputs": [
      "fact_experiment_cohort_daily.ad_revenue_usd",
      "fact_experiment_cohort_daily.enrolled_units",
      "dim_experiment_arm.allocation_unit"
    ],
    "guard": "分配单位明确；差异不自动等于显著性，不自动推广到全部玩家。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "operation_count",
    "label": "操作次数",
    "formula": "COUNT DISTINCT operation_event_id",
    "unit": "操作",
    "inputs": [
      "fact_ad_operation_event.operation_event_id"
    ],
    "guard": "多字段变更仍是一笔操作；未发现日志不证明无人操作。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  },
  {
    "metric_id": "sdk_af_revenue_gap",
    "label": "SDK与AF回收差额",
    "formula": "SUM(SDK revenue) - SUM(AF revenue) under matching scope",
    "unit": "USD",
    "inputs": [
      "fact_cohort_revenue_daily.revenue_source",
      "fact_cohort_revenue_daily.revenue_usd"
    ],
    "guard": "差额用于对照；不自动解释为丢数或真实收入下降。",
    "status": "dataset_definition_v1_runtime_certification_separate"
  }
]
